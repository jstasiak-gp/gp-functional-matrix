# Domyślnie: Git sam wykrywa pliki tekstowe i normalizuje końce linii w repozytorium do LF.
* text=auto

# ── Binaria — nigdy nie normalizuj (normalizacja uszkodziłaby plik) ──
*.xlsx  binary
*.xlsm  binary
*.docx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.zip   binary

# ── Pliki, które muszą mieć LF (uruchamiane w kontenerze Linux) ──
*.py        text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
*.conf      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf

# ── Dane i szablony ──
*.csv       text eol=lf
*.json      text eol=lf
*.md        text
*.tmpl      text eol=lf
